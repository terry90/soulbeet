#!/usr/bin/python3
"""Stands in for ffmpeg in the e2e stack, whose light image has none: the helper asks its
version; the fake yt-dlp writes Opus itself."""
import sys

if sys.argv[1:] == ["-version"]:
    print("ffmpeg version 8.0.1 Copyright (c) 2000-2025 the FFmpeg developers")
    sys.exit(0)
sys.exit(1)
