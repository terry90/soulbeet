# Optional overrides for compose.yaml.
# Copy this file to .env and adjust any values you want to change.

# Host folder where your music libraries live (mounted at /music in Soulbeet and Navidrome)
MUSIC_DIR=./music

# Host folder shared between slskd (/app/downloads) and Soulbeet (/downloads)
DOWNLOADS_DIR=./downloads

# Port for the Soulbeet web UI and API
SOULBEET_PORT=9765

# Soulbeet image tag: latest (light), latest-medium (AcoustID), or latest-full (art, lyrics, ReplayGain, yt-dlp)
SOULBEET_TAG=latest

# Port for the Navidrome web UI and Subsonic API
NAVIDROME_PORT=4533

# Port for the slskd web UI and API
SLSKD_PORT=5030
